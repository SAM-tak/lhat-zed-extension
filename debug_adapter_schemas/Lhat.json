{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L^ debugger",
  "type": "object",
  "required": ["request", "program"],
  "properties": {
    "request": {"type": "string", "enum": ["launch"], "default": "launch"},
    "program": {"type": "string", "minLength": 1, "description": "Absolute path to the .lh file to run."},
    "runtimePath": {"type": "string", "description": "Path to lhat or lhat.exe. Defaults to PATH."},
    "args": {"type": "array", "items": {"type": "string"}, "default": []},
    "cwd": {"type": "string", "description": "Working directory. Defaults to the worktree root."},
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "stopOnEntry": {"type": "boolean", "default": false},
    "relaxed": {"type": "boolean", "default": false}
  }
}
