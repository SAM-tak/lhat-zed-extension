module^ examples.outline

# Scalars and a function with a local binding.
let^ answer = 42
var^ count = 0
public^ let^ twice = f^ n:number^ -> number^ {
    let^ doubled = n * 2
    return^ doubled
}

let^ outer = f^ {
    let^ inner = f^ n:number^ { n + 1 }
    return^ inner
}

# Named members, instance fields, nested objects and operator methods.
let^ Reader = def^{
    self^{ text = "", at = 0 },
    limit = 10,
    peek = f^self^ -> string^ { return^ self^.text },
    op^+ = f^self^, rhs:number^ -> number^ { return^ rhs },
    options = { enabled = true^, nested = { value = 1 } },
}

enum^ Color { Red, Green = 3, Blue }
errordef^ Parse { Unexpected { at:number^ }, Spent }

let^ first, second = 1, 2
let^ registry = {}
var^ registry.helper = f^ { 1 }

if^ true^ {
    let^ branch = 1
}

# Comparisons, strings and commented-out declarations are not symbols.
if^ answer = count { }
let^ text = "let^ fake = 1"
#[~ let^ disabled = f^ {} ]#

return^ { run = twice, settings = { speed = 2 } }
